# ─────────────────────────────────────────────────────────────────────────────
# IGE Banking backend — environment configuration
# Copy to ".env". With NOTHING set, email & SMS run in "console" mode
# (logged to terminal + visible at /api/messages/outbox) so the demo never fails.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000

# ── EMAIL ────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: brevo | smtp | console
EMAIL_PROVIDER=console

# Option A (RECOMMENDED, FREE): Brevo — 300 emails/day + SMS + WhatsApp, one key.
# Sign up at https://www.brevo.com → SMTP & API → API Keys (v3).
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=campaigns@yourdomain.com   # must be a verified sender
# BREVO_SENDER_NAME=IGE Banking

# Option B (FREE): SMTP via Gmail App Password or Mailtrap sandbox.
#   Gmail:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
#   Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=587  SMTP_USER=<user>  SMTP_PASS=<pass>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=IGE Banking <campaigns@yourdomain.com>

# ── SMS ──────────────────────────────────────────────────────────────────────
# SMS_PROVIDER: brevo | termii | console
SMS_PROVIDER=console

# Option A (FREE): Brevo SMS — same BREVO_API_KEY above. Add free trial SMS credits.
# BREVO_SMS_SENDER=IGEBank

# Option B (FREE trial, Nigeria-native): Termii — https://termii.com
# TERMII_API_KEY=
# TERMII_SENDER_ID=IGEBank

# ── AI copy generation (optional) ────────────────────────────────────────────
# If unset, a deterministic CBN-compliant fallback is used.
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
